# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (use a local or Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/digital-health-record

# Allowed frontend origin for CORS (update when frontend is added)
CORS_ORIGIN=http://localhost:5173

# JWT authentication (use a long random secret in production)
JWT_SECRET=your-long-random-secret-here
JWT_EXPIRES_IN=7d

# MSG91 SMS provider (camp creation notifications)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_FLOW_ID=your-msg91-flow-id
MSG91_SENDER_ID=your-sender-id
